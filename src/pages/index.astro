---
import Layout from '../layouts/Layout.astro';
import '../styles/portfolio.css';
import musicLinks from '../data/music-links.json';
import { albumDestination, linkedMusicNote } from '../lib/music-links';
import AlbumSources from '../components/AlbumSources.astro';

const artists = [
  { name: 'Alicia Keys', category: 'ARTIST DEVELOPMENT / A&R', intro: 'An essential force in the making of two landmark albums.', works: [
    { album: 'Songs in A Minor', year: '2001', role: 'Contributed to the making of the album', note: 'Multi-Grammy-winning · Seven-times-platinum debut' },
    { album: 'The Diary of Alicia Keys', year: '2003', role: 'Contributed to the making of the album', note: 'Five-times-platinum follow-up' },
  ] },
  { name: 'Jazmine Sullivan', category: 'SIGNING / A&R / CO-PRODUCTION', intro: 'Signed to RCA. A creative partnership spanning four defining releases.', currentWork: 'In the studio working on Jazmine Sullivan’s forthcoming album, slated for release in 2027.', works: [
    { album: 'Fearless', year: '2008', role: 'A&R', note: 'Platinum debut · Five Grammy nominations' },
    { album: 'Love Me Back', year: '2010', role: 'Co-producer', note: 'Critically acclaimed second album. No. 17 on the Billboard 200 and No. 5 on Top R&B/Hip-Hop Albums. “Holding You Down (Goin’ in Circles)” and “10 Seconds” are both RIAA Gold-certified singles (January 13, 2026)—single certifications, not an album certification. “Holding You Down” earned a 2011 Grammy nomination for Best Female R&B Vocal Performance. Guardian critic Dan Hancox ranked the album No. 3 on his personal best-albums-of-2010 list.' },
    { album: 'Reality Show', year: '2015', role: 'Co-producer', note: 'Three Grammy nominations' },
    { album: 'Heaux Tales', year: '2021', role: 'Co-producer', note: 'Platinum-certified · Grammy winner, Best R&B Album' },
  ] },
  { name: 'Busta Rhymes', category: 'SIGNING CONTRIBUTION / A&R', intro: 'Aided in his signing to J Records and A&R’d two major releases.', works: [
    { album: 'Genesis', year: '2001', role: 'A&R', note: 'RIAA Platinum (U.S.). No. 7 on the Billboard 200 and No. 2 on Top R&B/Hip-Hop Albums. Features “Break Ya Neck” (No. 26, Hot 100). The single campaign’s “Pass the Courvoisier Part II,” featuring P. Diddy and Pharrell, reached No. 11 on the Hot 100 and earned a 2003 Grammy nomination for Best Rap Performance by a Duo or Group.' },
    { album: 'It Ain’t Safe No More...', year: '2002', role: 'A&R', note: 'RIAA Gold (U.S.). No. 43 on the Billboard 200 and No. 10 on Top R&B/Hip-Hop Albums. Includes “I Know What You Want,” with Mariah Carey and Flipmode Squad (No. 3, Hot 100), and “Make It Clap,” featuring Spliff Star (No. 46, Hot 100), with Sean Paul joining the remix.' },
  ] },
  { name: 'Tinashe', category: 'ARTIST SIGNING / ALBUM PRODUCTION / A&R', intro: 'Signed the boundary-pushing R&B artist to RCA and served as album producer and A&R across Aquarius, Nightride and Joyride. Her RCA-era recognition includes 2015 Best New Artist nominations at the BET Awards and Soul Train Awards, and selection as a 2015 YouTube Music Awards honoree.', works: [
    { album: 'Aquarius', year: '2014', role: 'Album producer / A&R', note: 'RCA debut. No. 17 on the Billboard 200, No. 2 on Top R&B Albums and No. 3 on Top R&B/Hip-Hop Albums. “2 On,” featuring ScHoolboy Q, is RIAA 4× Platinum, reached No. 24 on the Hot 100 and spent four weeks at No. 1 on Rhythmic Airplay. The single earned a 2014 Soul Train Best Dance Performance nomination and a 2015 BMI Most Performed R&B/Hip-Hop Songs award. Other singles include “Pretend,” featuring A$AP Rocky, and “All Hands on Deck,” certified Gold in New Zealand and, for its Iggy Azalea remix, Australia. Aquarius ranked No. 3 on both Billboard’s and Rolling Stone’s 2014 best R&B album lists, with additional year-end recognition from Pitchfork and Spin.' },
    { album: 'Nightride', year: '2016', role: 'Album producer / A&R', note: 'RCA’s 15-track alternative R&B project. No. 8 on Top R&B/Hip-Hop Albums and No. 89 on the Billboard 200. Ranked No. 16 among Rolling Stone’s 20 Best R&B Albums of 2016 and No. 14 among Fuse’s Best 20 Albums of 2016. Includes “Company,” “Party Favors” and “Ride of Your Life.”' },
    { album: 'Joyride', year: '2018', role: 'Album producer / A&R', note: 'RCA release. No. 58 on the Billboard 200 and No. 6 on the UK R&B Albums chart. Led by “No Drama,” featuring Offset; “Faded Love,” featuring Future; and “Me So Bad,” featuring Ty Dolla $ign and French Montana. The album also features Little Dragon on “Stuck with Me.”' },
  ] },
  { name: 'Blood Orange', category: 'ARTIST SIGNING', intro: 'Signed the visionary, genre-defying alt-pop artist.', works: [] },
  { name: 'Mario', category: 'ARTIST COLLABORATION', intro: 'Career credits include work with R&B artist Mario.', works: [] },
  { name: 'Marsha Ambrosius', category: 'ALBUM PRODUCTION / A&R', intro: 'Album producer and A&R for her J Records debut and RCA follow-up. Marsha won the 2011 BET Centric Award and received Best Female R&B Artist nominations at the 2011 and 2012 BET Awards. Her artist-level recognition also includes 2011 Soul Train nominations for Best R&B/Soul Female Artist and Best New Artist, plus 2014 MOBO nominations for Best Female Act and Best R&B/Soul Act.', works: [
    { album: 'Late Nights & Early Mornings', year: '2011', role: 'Album producer / A&R', note: 'J Records debut. No. 2 on the Billboard 200 and No. 1 on Top R&B/Hip-Hop Albums, with 96,400 first-week copies sold. “Far Away” reached No. 3 on Hot R&B/Hip-Hop Songs and No. 74 on the Hot 100, and earned two 2012 Grammy nominations: Best R&B Song and Best R&B Performance. It won the 2011 Soul Train Record of the Year (Ashford & Simpson Songwriter’s Award), received a 2011 BET Video of the Year nomination and was honored among the award-winning songs at the 2012 BMI Urban Music Awards. Other singles include “Hope She Cheats on You (With a Basketball Player)” (No. 22, Hot R&B/Hip-Hop Songs) and the title track.' },
    { album: 'Friends & Lovers', year: '2014', role: 'Album producer / A&R', note: 'RCA follow-up. No. 12 on the Billboard 200 and No. 2 on both Top R&B/Hip-Hop Albums and Top R&B Albums. Debuted with approximately 17,000 copies sold and was Billboard’s Hot Shot Debut on Top R&B/Hip-Hop Albums. “Run” reached No. 13 on Adult R&B Airplay and No. 44 on R&B/Hip-Hop Airplay. Includes “Stronger,” featuring Dr. Dre and reworking Sade’s “Stronger Than Pride”; “Spend All My Time,” featuring Charlie Wilson; and “Streets of London,” featuring Skye and Lindsey Stirling.' },
  ] },
  { name: 'Swizz Beatz', category: 'LABEL DEAL / FULL SURFACE', intro: 'Secured a multimillion-dollar deal for Swizz Beatz’s Full Surface Records at Clive Davis’s newly formed J Records—one of the label’s early hip-hop partnerships. The releases below showcase Full Surface’s J Records/RCA Music Group-era catalog achievements alongside Trevor’s label-deal credit.', works: [
    { album: 'Full Surface Records', year: 'J RECORDS / RCA MUSIC GROUP', role: 'Label partnership', note: 'A hip-hop and R&B label partnership distributed through J Records, which became part of RCA Music Group. Its early roster included Cassidy, Yung Wun and Mashonda. Trevor’s credit here is the Full Surface deal; the following cards highlight the label’s releases rather than individual album-production or A&R roles.' },
    { album: 'Split Personality', year: '2004', role: 'Cassidy / Full Surface catalog', note: 'Full Surface/J Records debut. RIAA Gold (U.S.). No. 2 on the Billboard 200 and No. 1 on Top R&B/Hip-Hop Albums. Breakout single “Hotel” reached No. 4 on the Hot 100, No. 6 on Hot R&B/Hip-Hop Songs and No. 3 on the UK Singles Chart. “Get No Better,” featuring Mashonda, reached No. 82 on the Hot 100. Other album guests include Snoop Dogg, Styles P and Jadakiss.' },
    { album: 'The Dirtiest Thirstiest', year: '2004', role: 'Yung Wun / Full Surface catalog', note: 'Full Surface/J Records debut. No. 50 on Top R&B/Hip-Hop Albums, No. 24 on Top Rap Albums and No. 11 on Heatseekers Albums. “Tear It Up,” featuring DMX, Lil’ Flip and David Banner, reached No. 76 on the Hot 100 and No. 39 on Hot R&B/Hip-Hop Songs. “Walk It, Talk It,” featuring David Banner, reached No. 97 on Hot R&B/Hip-Hop Songs. The album also features Cassidy.' },
    { album: 'I’m a Hustla', year: '2005', role: 'Cassidy / Full Surface catalog', note: 'Full Surface/J Records release. No. 5 on the Billboard 200 and No. 2 on both Top R&B/Hip-Hop Albums and Top Rap Albums. “I’m a Hustla,” produced by Swizz Beatz, reached No. 34 on the Hot 100 and No. 5 on Hot Rap Songs, and earned a 2005 Vibe Award nomination for Street Anthem. The song is RIAA Gold as a digital single and Platinum as a mastertone/ringtone—not an album certification. Includes “B-Boy Stance,” with album guests Nas, Mario, Lil Wayne, Fabolous and Mary J. Blige.' },
    { album: 'January Joy', year: '2005', role: 'Mashonda / Full Surface catalog', note: 'Full Surface/J Records R&B debut. Features Kanye West, Snoop Dogg, Jadakiss, Nas and Raphael Saadiq. Singles “Back of da Club” and “Blackout” reached No. 86 and No. 96, respectively, on Hot R&B/Hip-Hop Songs. Swizz Beatz served as executive producer and produced “Back of da Club.”' },
    { album: 'B.A.R.S. The Barry Adrian Reese Story', year: '2007', role: 'Cassidy / Full Surface catalog', note: 'Full Surface/J Records release. No. 10 on the Billboard 200, No. 3 on Top R&B/Hip-Hop Albums and No. 2 on Top Rap Albums. “My Drink n My 2 Step,” featuring Swizz Beatz, reached No. 33 on the Hot 100 and No. 11 on Hot R&B/Hip-Hop Songs. “Innocent Man (Misunderstood),” featuring Mark Morrison, reached No. 3 on Bubbling Under Hot 100 Singles. Album guests include John Legend, Eve and Bone Thugs-n-Harmony.' },
  ] },
];
const additionalArtists = ['A$AP Rocky', 'Monica'];
const archive = [
  { file: 'trevor-jerideau-alicia-keys', label: 'Trevor Jerideau and Alicia Keys', alt: 'Trevor Jerideau and Alicia Keys' },
  { file: 'trevor-industry-event', label: 'Trevor Jerideau and Clive Davis', alt: 'Trevor Jerideau and Clive Davis' },
  { file: 'trevor-studio-session-expanded', label: 'Trevor Jerideau and Kyrie Irving', alt: 'Trevor Jerideau and Kyrie Irving' },
  { file: 'trevor-group-celebration', label: 'Trevor Jerideau, Alicia Keys, EVE and Angie Stone', alt: 'Trevor Jerideau, Alicia Keys, EVE and Angie Stone' },
  { file: 'trevor-naacp-image-award', label: 'NAACP IMAGE Award', alt: 'NAACP IMAGE Award' },
  { file: 'trevor-studio-group', label: 'Trevor Jerideau, Tinashe and Metro Boomin’', alt: 'Trevor Jerideau, Tinashe and Metro Boomin’' },
  { file: 'trevor-artist-collab', label: 'Trevor Jerideau and ASAP YAM$', alt: 'Trevor Jerideau and ASAP YAM$' },
  { file: 'trevor-artist-meeting', label: 'Trevor Jerideau and ASAP ROCKY', alt: 'Trevor Jerideau and ASAP ROCKY' },
  { file: 'trevor-grammy-trophy-2', label: 'Grammy Award Producer Best R&B Album', alt: 'Grammy Award Producer Best R&B Album' },
  { file: 'trevor-industry-gathering', label: 'Trevor Jerideau, LA Reid, Mayor Bill de Blasio', alt: 'Trevor Jerideau, LA Reid, Mayor Bill de Blasio' },
  { file: 'trevor-shared-moments', label: 'Trevor Jerideau, Rev. Jesse Jackson and Busta Rhymes', alt: 'Trevor Jerideau, Rev. Jesse Jackson and Busta Rhymes' },
];
const awards = [
  { file: 'trevor-grammy-trophy-1', title: 'Grammy Award', subtitle: 'BEST R&B ALBUM', description: 'Co-producer of Jazmine Sullivan’s Heaux Tales.', alt: 'Grammy trophy from Trevor Jerideau’s personal archive' },
  { file: 'trevor-naacp-award-trophy', title: 'NAACP Image Award', subtitle: 'CULTURAL RECOGNITION', description: 'Recognition of his contributions to music and culture.', alt: 'NAACP Image Awards trophy' }, // Source: https://naacp.org/articles/picturing-excellence-scenes-56th-naacp-image-awards
  { file: 'trevor-young-leadership', title: 'Young Leadership Award', subtitle: 'FOUNDATION FOR ETHNIC UNDERSTANDING', description: 'Honoring community leadership and cultural impact.', alt: 'Young Leadership Award photograph from Trevor Jerideau’s archive' },
];
const grid = Array.from({ length: 64 }, (_, i) => {
  const row = Math.floor(i / 8), col = i % 8;
  return (row === 1 && col >= 1 && col <= 6) || (row === 2 && col >= 1 && col <= 6) || (row >= 3 && row <= 6 && col >= 3 && col <= 4) || (row === 5 && col === 6);
});
const lightOrder = grid.map((filled, index) => filled ? grid.slice(0, index).filter(Boolean).length : -1);
---

<Layout title="Trevor Jerideau | Grammy Award-Winning Music Executive & Producer" description="Explore Trevor Jerideau’s official biography, artist credits, soundtrack work and current projects. Grammy Award-winning music executive and producer.">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label="Trevor Jerideau — back to top">TREVOR<br />JERIDEAU</a>
    <nav class="main-nav" aria-label="Main navigation">
      <a href="#biography">Biography</a><a href="#artists">The work</a><a href="#archive">Archive</a><a href="#contact">Contact</a>
    </nav>
    <a class="grid-mark" href="#top" aria-label="Trevor Jerideau geometric T mark — back to top">
      {grid.map((filled, index) => <span class:list={{ filled }} aria-hidden="true" style={filled ? `--cell-delay: ${lightOrder[index] * 0.4}s` : undefined}></span>)}
    </a>
  </header>

  <main id="main">
    <section class="hero page-pad" id="top" aria-labelledby="hero-heading">
      <div class="hero-meta mono"><span>NEW YORK / MUSIC & CULTURE</span><span>THE OFFICIAL PORTFOLIO</span></div>
      <div class="hero-grid">
        <div class="hero-content">
          <img class="tj-seal" src="/images/tj-archive-seal.webp" alt="TJ monogram" width="1200" height="1200" />
          <h1 id="hero-heading">TREVOR<br />JERIDEAU<span class="title-period">.</span></h1>
          <div class="hero-bottom">
            <p>Music executive.<br />Artist advocate.<br />Culture in motion.</p>
            <a class="text-link mono" href="#biography">EXPLORE THE STORY <span aria-hidden="true">↘</span></a>
          </div>
        </div>
        <figure class="hero-portrait">
          <div class="portrait-frame"><img src="/images/trevor-portrait-final.webp" alt="Portrait of Trevor Jerideau, Grammy Award-winning music executive and producer" width="1600" height="1412" fetchpriority="high" /></div>
          <figcaption class="mono"><span>PORTRAIT / TREVOR JERIDEAU</span><span>01 — NYC</span></figcaption>
        </figure>
      </div>
      <div class="hero-foot mono"><span>A&R · ARTIST DEVELOPMENT · PRODUCTION · PUBLISHING</span><span class="hero-star" aria-hidden="true">✳</span><span>ARISTA / J RECORDS / RCA / INDEPENDENT</span></div>
    </section>

    <section class="statement page-pad" aria-labelledby="statement-heading">
      <div class="section-kicker mono"><span>THE PERSPECTIVE</span><span>20+ YEARS IN MUSIC</span></div>
      <h2 id="statement-heading">GREAT RECORDS.<br />LASTING CAREERS.</h2>
      <div class="statement-bottom"><span class="statement-star" aria-hidden="true">✳</span><p>A Grammy Award-winning music executive combining creative intuition with business acumen to build sustainable artist careers—and records with a profound cultural impact.</p></div>
    </section>

    <section class="biography page-pad light-section" id="biography" aria-labelledby="bio-heading">
      <div class="section-kicker mono"><span>01 / BIOGRAPHY</span><span>THE COMPLETE STORY</span></div>
      <div class="chapter-heading"><h2 id="bio-heading">THE VISION.<br />THE JOURNEY.</h2><span class="mono">LONG ISLAND → NEW YORK</span></div>
      <div class="bio-grid">
        <aside class="bio-aside">
          <figure><img src="/images/trevor-clive-davis.webp" alt="Trevor Jerideau, Busta Rhymes and Swizz Beatz" width="750" height="719" loading="lazy" /><figcaption class="mono">Trevor Jerideau, Busta Rhymes and Swizz Beatz</figcaption></figure>
          <div class="career-index mono"><span>CAREER INDEX</span><ol><li><span>01</span> ARISTA RECORDS</li><li><span>02</span> J RECORDS</li><li><span>03</span> RCA RECORDS</li><li><span>04</span> INDEPENDENT VISION</li></ol></div>
        </aside>
        <div class="bio-copy">
          <p class="bio-lead">Trevor Jerideau is a high-level executive with over two decades of experience in the music business, during which time he’s achieved such triumphs as winning a Grammy Award for co-producing Jazmine Sullivan’s critically acclaimed <em>Heaux Tales</em>. In his longtime role as senior vice president of A&R for RCA Records, the New York City-based industry veteran played a vital part in developing the careers of luminaries like Alicia Keys and in signing genre-defining icons like Busta Rhymes, continually tapping into his rare balance of forward-thinking vision and acute business acumen.</p>
          <div class="bio-part"><h3 class="mono">01 — THE FOUNDATION / ARISTA & J RECORDS</h3><p>Originally from Long Island, Jerideau earned his degree in finance at Fordham University. He began pursuing his love of music while in college with an internship at Def Jam, followed by an A&R internship at Arista Records—an experience that soon led to his working closely with legendary mogul Clive Davis. After exiting Arista, Davis handpicked Jerideau as an A&R manager for his newly launched J Records. Quickly progressing to A&R director, Jerideau aided in the signing of Busta Rhymes and A&R-ing 2001’s platinum-selling <em>Genesis</em> and 2002’s gold-selling <em>It Ain’t Safe No More...</em> He also served as an essential force in the making of Alicia Keys’s multi-Grammy-winning, seven-times-platinum debut <em>Songs in A Minor</em> and its five-times-platinum follow-up <em>The Diary of Alicia Keys</em>.</p></div>
          <div class="bio-part"><h3 class="mono">02 — ARTIST DEVELOPMENT / RCA RECORDS</h3><p>With J Records later folded into RCA, Jerideau was next appointed SVP of A&R at RCA and signed such visionary artists as Jazmine Sullivan. After A&R-ing Sullivan’s platinum-selling full-length debut <em>Fearless</em> (a 2008 release that nabbed her five Grammy nominations), Jerideau went on to co-produce 2010’s widely lauded <em>Love Me Back</em>, 2015’s three-time Grammy-nominated <em>Reality Show</em>, and 2021’s platinum-certified <em>Heaux Tales</em> (a Grammy winner for Best R&B Album). In addition, Jerideau signed boundary-pushing artists like R&B phenom Tinashe and alt-pop polymath Blood Orange. All told, Jerideau’s contributions have helped to generate album sales in the tens of millions to date.</p></div>
          <div class="bio-part"><h3 class="mono">03 — AN INDEPENDENT VISION / 2021 ONWARD</h3><p>Since leaving his position at RCA in 2021, Jerideau has worked with the label in a consulting capacity while embarking on the launch of his own production/publishing company—an enterprise uniquely rooted in the blockchain, for the sake of providing full financial transparency for artists. A community leader whose accolades include an NAACP Image Award and the Foundation for Ethnic Understanding’s Young Leadership Award, Jerideau regards the company as a crucial next step in his mission of cultivating sustainable careers for artists with a profound cultural impact.</p></div>
          <div class="bio-part"><h3 class="mono">04 — FURTHER CREDITS & CURRENT WORK</h3><p>Jerideau’s career also includes work with Mario, Swizz Beatz and A$AP Rocky, and A&R credits on the soundtracks for <em>The Best Man</em>, <em>Uncle Drew</em> and <em>Chi-Raq (Original Motion Picture Soundtrack)</em>, for the film directed by acclaimed filmmaker Spike Lee. He is currently in the studio working on Jazmine Sullivan’s forthcoming album, slated for release in 2027.</p></div>
        </div>
      </div>
    </section>

    <section class="artists page-pad" id="artists" aria-labelledby="artists-heading">
      <div class="section-kicker mono"><span>02 / SELECTED ARTIST WORK</span><span>THE PEOPLE. THE RECORDS.</span></div>
      <div class="chapter-heading"><h2 id="artists-heading">CULTURE,<br />ON RECORD.</h2><p>Distinct voices. Defining releases.<br />Explore the work behind the names.</p></div>
      <div class="artist-list">
        {artists.map((artist, index) => <details class="artist-row" open={index === 1}>
          <summary><span class="artist-number mono">0{index + 1}</span><h3>{artist.name}</h3><span class="artist-category mono">{artist.category}</span><span class="artist-toggle" aria-hidden="true">+</span></summary>
          <div class="artist-body"><p>{artist.intro}</p>{artist.currentWork && <aside class="project-update" aria-label="Current Jazmine Sullivan project"><span class="mono">CURRENT WORK / SLATED FOR 2027</span><p>{artist.currentWork}</p></aside>}{artist.works.length > 0 && <div class="record-grid">{artist.works.map(work => {
            const destination = albumDestination(musicLinks, artist.name, work.album);
            return <article class="record"><span class="record-year mono">{work.year} / {work.role}</span><h4>{destination ? <a class="record-album-link" href={destination.url} target="_blank" rel="noopener noreferrer" aria-label={`Listen to ${work.album} on ${destination.service} (opens in a new tab)`}>{work.album}</a> : work.album}</h4><p>{linkedMusicNote(musicLinks, artist.name, work.note).map(part => part.destination ? <a class="record-song-link" href={part.destination.url} target="_blank" rel="noopener noreferrer" aria-label={`Listen to ${part.destination.title} on ${part.destination.service} (opens in a new tab)`}>{part.text}</a> : part.text)}</p><AlbumSources artist={artist.name} album={work.album} /></article>;
          })}</div>}</div>
        </details>)}
        {additionalArtists.map((name, index) => <div class="artist-row"><div class="artist-name-only"><span class="artist-number mono">{String(artists.length + index + 1).padStart(2, '0')}</span><h3>{name}</h3></div></div>)}
      </div>
      <div class="mentor-note"><span class="mono">EXECUTIVE COLLABORATION</span><p><strong>Clive Davis.</strong> A formative mentor and collaborator, from Arista to the launch of J Records.</p><span><a href="https://en.wikipedia.org/wiki/Clive_Davis" target="_blank" rel="noopener noreferrer" aria-label="Clive Davis on Wikipedia (opens in a new tab)" style="color:inherit">↗</a></span></div>
      <section class="soundtrack-work" id="soundtracks" aria-labelledby="soundtracks-heading">
        <div class="section-kicker mono"><span>02.B / SOUNDTRACK WORK</span><span>BEYOND THE ALBUM</span></div>
        <h3 id="soundtracks-heading">MUSIC FOR<br />THE SCREEN.</h3>
        <div class="record-grid">
          <article class="record soundtrack-credit"><span class="record-year mono">01 / FILM SOUNDTRACK</span><h4><a class="record-album-link soundtrack-listen-link" href="https://music.apple.com/us/album/the-best-man-music-from-the-motion-picture/265134440" target="_blank" rel="noopener noreferrer" aria-label="Listen to The Best Man soundtrack on Apple Music (opens in a new tab)">The Best Man</a></h4><p>A&R.</p></article>
          <article class="record soundtrack-credit"><span class="record-year mono">02 / FILM SOUNDTRACK</span><h4><a class="record-album-link soundtrack-listen-link" href="https://music.apple.com/us/album/uncle-drew-original-motion-picture-soundtrack/1376316256" target="_blank" rel="noopener noreferrer" aria-label="Listen to Uncle Drew soundtrack on Apple Music (opens in a new tab)">Uncle Drew</a></h4><p>A&R.</p></article>
          <article class="record soundtrack-credit"><span class="record-year mono">03 / FILM SOUNDTRACK</span><h4><a class="record-album-link soundtrack-listen-link" href="https://music.apple.com/us/album/chi-raq-original-motion-picture-soundtrack/1055437710" target="_blank" rel="noopener noreferrer" aria-label="Listen to Chi-Raq (Original Motion Picture Soundtrack) on Apple Music (opens in a new tab)">Chi-Raq (Original Motion Picture Soundtrack)</a></h4><p>A&R.</p></article>
        </div>
      </section>
    </section>

    <section class="archive page-pad light-section" id="archive" aria-labelledby="archive-heading">
      <div class="section-kicker mono"><span>03 / THE PERSONAL ARCHIVE</span><span>BEYOND THE CREDITS</span></div>
      <div class="chapter-heading"><h2 id="archive-heading">IN GOOD<br />COMPANY.</h2><p>The rooms. The relationships.<br />The moments that make a career.</p></div>
      <div class="archive-grid">{archive.map((photo, index) => <figure class="archive-card">
        <button type="button" class="archive-photo" data-photo={`/images/${photo.file}.webp`} data-caption={`ARCHIVE / ${String(index + 1).padStart(2, '0')} — ${photo.label}`} data-alt={photo.alt} aria-label={`Enlarge archive photograph ${index + 1}: ${photo.label}`}><img src={`/images/${photo.file}.webp`} alt={photo.alt} loading="lazy" width="750" height="750" /><span class="photo-open mono" aria-hidden="true">VIEW ↗</span></button>
        <figcaption class="mono"><span>{String(index + 1).padStart(2, '0')} / {photo.label}</span><span aria-hidden="true">+</span></figcaption>
      </figure>)}</div>
    </section>

    <section class="recognition page-pad" id="recognition" aria-labelledby="recognition-heading">
      <div class="section-kicker mono"><span>04 / RECOGNITION</span><span>MUSIC. COMMUNITY. IMPACT.</span></div>
      <div class="chapter-heading"><h2 id="recognition-heading">WORK THAT<br />RESONATES.</h2><span class="recognition-star" aria-hidden="true">✳</span></div>
      <div class="awards-grid">{awards.map(award => <article class="award"><div class="award-image"><img src={`/images/${award.file}.webp`} alt={award.alt} width="750" height="900" loading="lazy" /></div><span class="mono">{award.subtitle}</span><h3>{award.title}</h3><p>{award.description}</p></article>)}</div>
