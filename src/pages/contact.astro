---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact | Trevor Jerideau"
  description="Contact information for Trevor Jerideau is now part of his one-page portfolio."
  noindex
>
  <meta slot="head" http-equiv="refresh" content="0;url=/#contact" />
  <main>
    <p class="eyebrow">Trevor Jerideau</p>
    <h1>Let’s connect.</h1>
    <p><a href="/#contact">Continue to Trevor Jerideau’s contact section.</a></p>
    <nav aria-label="Contact links">
      <a href="mailto:trevor@trevorjerideau.com">trevor@trevorjerideau.com</a>
      <a href="https://www.instagram.com/trevamir" target="_blank" rel="noopener noreferrer">Instagram</a>
      <a href="https://www.linkedin.com/in/trevorjerideau" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
  </main>
  <script is:inline>
    window.location.replace('/#contact');
  </script>
</Layout>

<style>
  main { max-width: 48rem; margin: 0 auto; padding: 20vh 1.5rem; }
  .eyebrow { font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; }
  h1 { margin: 1.5rem 0; font-size: clamp(2rem, 6vw, 4rem); font-weight: 500; line-height: 1.1; }
  nav { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; margin-top: 2rem; }
  a { text-underline-offset: 0.25em; overflow-wrap: anywhere; }
</style>
