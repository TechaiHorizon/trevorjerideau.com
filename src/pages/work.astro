---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Artists & Work | Trevor Jerideau"
  description="Trevor Jerideau’s artist collaborations are now part of his one-page portfolio."
  noindex
>
  <meta slot="head" http-equiv="refresh" content="0;url=/#artists" />
  <main>
    <p class="eyebrow">Trevor Jerideau</p>
    <h1>The work has moved.</h1>
    <p><a href="/#artists">Explore Trevor Jerideau’s artist collaborations.</a></p>
  </main>
  <script is:inline>
    window.location.replace('/#artists');
  </script>
</Layout>

<style>
  main { max-width: 48rem; margin: 0 auto; padding: 20vh 1.5rem; }
  .eyebrow { font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; }
  h1 { margin: 1.5rem 0; font-size: clamp(2rem, 6vw, 4rem); font-weight: 500; line-height: 1.1; }
  a { text-underline-offset: 0.25em; }
</style>
