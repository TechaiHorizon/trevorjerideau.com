---
interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}

const {
	title = 'Trevor Jerideau — Grammy Award-Winning Music Executive',
	description = 'Trevor Jerideau is a Grammy Award-winning music executive and former RCA SVP of A&R. Explore his biography, artist collaborations, and contact information.',
	image = 'https://trevorjerideau.com/images/trevor-portrait.webp',
	noindex = false,
} = Astro.props;

const canonicalUrl = 'https://trevorjerideau.com/';
const siteTitle = title.includes('Trevor Jerideau') ? title : `${title} | Trevor Jerideau`;
const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	'@id': `${canonicalUrl}#person`,
	name: 'Trevor Jerideau',
	url: canonicalUrl,
	image: 'https://trevorjerideau.com/images/trevor-portrait.webp',
	jobTitle: 'Music Executive',
	description: 'Trevor Jerideau is a Grammy Award-winning music executive and former Senior Vice President of A&R at RCA Records. He co-produced Jazmine Sullivan’s 2021 album Heaux Tales, a Best R&B Album winner. His credits include Alicia Keys, Jazmine Sullivan, Busta Rhymes and Mario, signings of Tinashe and Blood Orange, and soundtrack contributions to The Best Man and Uncle Drew. He is currently working in the studio on Jazmine Sullivan’s forthcoming album, slated for release in 2027.',
	award: [
		'Grammy Award — co-producing Jazmine Sullivan’s Heaux Tales, Best R&B Album',
		'NAACP Image Award',
		'Foundation for Ethnic Understanding Young Leadership Award',
	],
	alumniOf: {
		'@type': 'CollegeOrUniversity',
		name: 'Fordham University',
	},
	hasCredential: {
		'@type': 'EducationalOccupationalCredential',
		name: 'Finance degree',
		credentialCategory: 'Degree',
		recognizedBy: {
			'@type': 'CollegeOrUniversity',
			name: 'Fordham University',
		},
	},
	sameAs: [
		'https://www.linkedin.com/in/trevorjerideau',
		'https://www.instagram.com/trevamir',
	],
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonicalUrl,
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#070707" />
		<title>{siteTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Trevor Jerideau" />
		<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
		<link rel="canonical" href={canonicalUrl} />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={siteTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:image:alt" content="Portrait of Trevor Jerideau" />
		<meta property="og:site_name" content="Trevor Jerideau" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={siteTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:image:alt" content="Portrait of Trevor Jerideau" />

		{!noindex && (
			<script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
		)}

		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&amp;family=Space+Grotesk:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		--color-text: #f2f1ed;
		--color-text-light: #aaa9a4;
		--color-bg: #070707;
		--color-bg-alt: #111111;
		--color-border: #30302e;
		--color-accent: #f2f1ed;
		--font-sans: 'Space Grotesk', sans-serif;
		--font-mono: 'IBM Plex Mono', monospace;
		--spacing-unit: 1rem;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		font-family: var(--font-sans);
		background: var(--color-bg);
		color: var(--color-text);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-height: 100vh;
		line-height: 1.5;
	}

	h1, h2, h3, h4, h5, h6, p, figure {
		margin: 0;
	}

	a {
		color: inherit;
	}

	button, input, textarea, select {
		font: inherit;
	}

	img {
		max-width: 100%;
		height: auto;
		display: block;
	}

	:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 5px;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto !important;
		}
	}
</style>
